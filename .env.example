# ── Domain ────────────────────────────────────────────────────────────────
# The apex domain shops live under. Shops are served at <name>.<ROOT_DOMAIN>.
# Local development: use localhost:3000 and open http://anna.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=myqr.co.nz

# ── Database (Neon via the Vercel integration sets this for you) ──────────
# Any Postgres URL works. Neon URLs use the serverless HTTP driver,
# everything else (e.g. local Postgres) uses node-postgres.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── Photo & logo storage (Vercel Blob) ────────────────────────────────────
# Created automatically when you add a Blob store to the Vercel project.
# Without it, uploads are written to public/uploads in development only.
BLOB_READ_WRITE_TOKEN=

# ── Email (Resend) ────────────────────────────────────────────────────────
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM="myQR <hello@myqr.co.nz>"

# ── Platform admin ────────────────────────────────────────────────────────
# Comma-separated emails that get access to /admin once they register.
ADMIN_EMAILS=you@example.com

# ── Payments (not wired up yet) ───────────────────────────────────────────
# While false, sellers can publish their shop without paying the setup fee
# and shoppers send an enquiry instead of checking out.
PAYMENTS_ENABLED=false
