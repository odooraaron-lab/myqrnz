# ── Domain ────────────────────────────────────────────────────────────────
# The apex domain shops live under. Shops are served at <name>.<ROOT_DOMAIN>.
# Local development: use localhost:3000 and open http://anna.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=myqr.co.nz

# ── Database (Neon via the Vercel integration sets this for you) ──────────
# Any Postgres URL works. Neon URLs use the serverless HTTP driver,
# everything else (e.g. local Postgres) uses node-postgres.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── Photo & logo storage (Vercel Blob) ────────────────────────────────────
# Created automatically when you add a Blob store to the Vercel project.
# Without it, uploads are saved to .data/uploads in development only
# (set ALLOW_LOCAL_UPLOADS=1 to allow that under `next start` for local testing).
BLOB_READ_WRITE_TOKEN=

# ── Email (Resend) ────────────────────────────────────────────────────────
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM="myQR <hello@myqr.co.nz>"

# ── Platform admin ────────────────────────────────────────────────────────
# Comma-separated emails that get access to /admin once they register.
ADMIN_EMAILS=you@example.com

# ── Payments (Stripe) ─────────────────────────────────────────────────────
# While false, sellers publish without paying the setup fee and shoppers send
# an enquiry instead of checking out. Set true once the keys below are in.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://myqr.co.nz/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Seller payouts. false: you pay sellers by bank transfer and mark payouts paid.
# true: sellers verify once with Stripe (no Stripe login) and you send payouts
# with one click. Needs Connect enabled on your Stripe account, plus a second
# webhook endpoint (same URL) listening to connected accounts for account.updated.
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_WEBHOOK_SECRET=

# Days each sale is held before it can be withdrawn, and the smallest payout (NZD).
PAYOUT_HOLD_DAYS=7
PAYOUT_MINIMUM=20
